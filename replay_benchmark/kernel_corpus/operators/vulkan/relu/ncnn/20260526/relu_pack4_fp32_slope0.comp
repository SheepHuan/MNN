// Historical shader: relu (FP32, pack4, slope=0)
// Origin: sources/ncnn/20260526/src/layer/vulkan/shader/relu.comp
// Macro branches baked (FP32 pure path, slope=0 via spec constant).
// Entry: main
#version 450

layout(constant_id = 0) const float slope = 0;

#define shape_constant_id_offset 1
layout(constant_id = shape_constant_id_offset + 0) const uint n = 0;

layout(binding = 0) buffer bottom_top_blob { vec4 bottom_top_blob_data[]; };

layout(push_constant) uniform parameter
{
    uint n;
} p;

#define sfp float
#define sfpvec4 vec4
#define afp float
#define afpvec4 vec4
#define buffer_ld4(buf,i) buf[i]
#define buffer_st4(buf,i,v) {buf[i]=v;}
#define psc(x) (x==0?p.x:x)

void main()
{
    uint gi = gl_GlobalInvocationID.x;

    if (gi >= psc(n))
        return;

    vec4 v = buffer_ld4(bottom_top_blob_data, gi);

    if (slope == 0)
        v = max(v, 0.0f);
    else
        v = mix(v, v * slope, lessThan(v, vec4(0.0f)));

    buffer_st4(bottom_top_blob_data, gi, v);
}
